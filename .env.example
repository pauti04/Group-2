# Copy to .env — .env is gitignored, never commit a real key.

# Step 4 only. Steps 1-2 run without any key using RAG_BACKEND=stub.
GROQ_API_KEY=

# stub = deterministic keyword retriever, no key, no downloads (default)
# real = rag/retrieval.py, the fusion-retrieval pipeline
RAG_BACKEND=stub

# Minimum retrieval score before we answer at all. Below it the Specialist
# fails the task with NO_RELEVANT_CONTEXT instead of guessing.
RAG_RELEVANCE_THRESHOLD=0.15
